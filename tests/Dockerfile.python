# Containerized Python unit tests for the GetGitHubToken function.
# Build from the repository root:
#   docker build -t gh-token-pytests -f tests/Dockerfile.python .
#   docker run --rm gh-token-pytests
# Tracks scripts/deploy.sh --runtime-version so the suite runs on the same
# interpreter as production. The azure-functions pin in requirements.txt is
# what actually keeps the SDK version from drifting with the interpreter --
# unpinned, 3.13+ resolves to 2.x, which cannot install on the 3.11 runtime.
FROM python:3.11-slim

WORKDIR /app

# Install deps first so image layers cache independently of source changes.
COPY requirements.txt tests/requirements-test.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-test.txt

COPY GetGitHubToken/ ./GetGitHubToken/
COPY tests/test_function.py ./tests/

CMD ["python", "-m", "pytest", "tests/test_function.py", "-v"]
