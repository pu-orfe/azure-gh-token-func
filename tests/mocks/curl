#!/bin/bash

# Mock curl for testing
# Returns a fake GitHub token

for arg in "$@"; do
    if [[ "$arg" == *"getgithubtoken"* ]]; then
        printf "ghs_MockTestToken1234567890abcdefghijk\n200"  # body, then -w "\n%{http_code}"
        exit 0
    fi
done

echo "Mock curl: Unknown request" >&2
exit 1
